<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Рынок гильдий"
    MinSize="900 620"
    SetSize="1120 760">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
            <RichTextLabel Name="BalanceInfo" HorizontalExpand="True" />
            <Button Name="WithdrawButton" Text="Снять средства" MinWidth="140" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
            <Button Name="CommonButton" Text="Общие" MinWidth="140" />
            <Button Name="UniqueButton" Text="Уникальные" MinWidth="140" Margin="6 0 0 0" />
            <Button Name="ManagementButton" Text="Управление заказами" MinWidth="210" Margin="6 0 0 0" />
        </BoxContainer>
        <LineEdit Name="SearchBar" PlaceHolder="Поиск по всем товарам" HorizontalExpand="True" Margin="0 0 0 6" />
        <BoxContainer Name="MarketView" Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer MinWidth="160" Margin="0 0 6 0">
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                    <BoxContainer Name="CategoryContainer" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
            </PanelContainer>
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="0 0 6 0">
                <GridContainer Name="ItemsGrid" Columns="3" HorizontalExpand="True" />
            </ScrollContainer>
            <PanelContainer MinWidth="300" MaxWidth="340">
                <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
                    <Label Name="SelectedName" Text="Выберите товар" HorizontalExpand="True" />
                    <PanelContainer Name="SelectedPreview" MinSize="96 96" Margin="0 6" />
                    <RichTextLabel Name="SelectedStats" MinHeight="72" />
                    <BoxContainer Orientation="Horizontal" Margin="0 4">
                        <LineEdit Name="BuyPrice" PlaceHolder="Цена заказа" HorizontalExpand="True" />
                        <Button Name="CreateBuyOrderButton" Text="Заказ" MinWidth="76" Margin="4 0 0 0" />
                    </BoxContainer>
                    <Label Text="Заявки рынка" Margin="0 4" />
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                        <BoxContainer Name="OffersContainer" Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <ScrollContainer Name="ManagementView" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Visible="False">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Text="Активные лоты и заказы" Margin="4" />
                <BoxContainer Name="ManagedOffersContainer" Orientation="Vertical" HorizontalExpand="True" />
                <Label Text="Предметы, полученные по заказам" Margin="4 12 4 4" />
                <BoxContainer Name="StoredItemsContainer" Orientation="Vertical" HorizontalExpand="True" />
            </BoxContainer>
        </ScrollContainer>
        <PanelContainer Name="OfferCreationPanel" Margin="0 6 0 0">
            <BoxContainer Orientation="Horizontal" Margin="6">
                <Label Text="Предмет в активной руке:" VerticalAlignment="Center" />
                <Label Name="HeldCategory" Text="Появится: —" VerticalAlignment="Center" Margin="6 0" MinWidth="190" />
                <LineEdit Name="HeldPrice" PlaceHolder="Цена" MinWidth="130" Margin="6 0" />
                <Button Name="CreateSellOfferButton" Text="Выставить лот" MinWidth="130" />
                <Button Name="CreateHeldBuyOrderButton" Text="Создать заказ по образцу" MinWidth="190" Margin="6 0 0 0" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
