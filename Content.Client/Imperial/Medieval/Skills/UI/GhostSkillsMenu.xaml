<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc 'ghost-skills-window-title'}"
    MinSize="420 480"
    SetSize="480 650">
    <BoxContainer Orientation="Vertical" Margin="6">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
            <Label Name="PointsLabel" HorizontalExpand="True" VerticalAlignment="Center" />
            <Button Name="SaveButton" Text="{Loc 'ghost-skills-save'}" MinWidth="110" />
        </BoxContainer>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="SkillsContainer" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
