<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'praises-window-title'}"
               Resizable="False">
    <BoxContainer Orientation="Vertical">
        <RichTextLabel Name="MessageLabel" Text=""/>
        <RichTextLabel Text="{Loc 'praises-window-reason'}:" />
        <LineEdit Name="ReasonEdit"
                  HorizontalExpand="True"/>
        <Button Name="SendButton"
                Text="{Loc 'praises-window-send'}"
                HorizontalExpand="True"/>
    </BoxContainer>
</DefaultWindow>
